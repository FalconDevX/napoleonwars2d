# Godot cache
.godot/
*.tmp
# Lokalne kopie zapasowe
_bak_*/
# Surowe źródła portretów (ciężkie, ~258 MB)
tools/_zrodla_portretow/
# Python
__pycache__/
*.pyc
# Godot pobrany automatycznie przez _godot.bat
godot/

# Wyeksportowane wersje gry (np. przegladarkowa)
build/

# Duze pliki wideo (ujecia, napisy) - zbyt ciezkie do repozytorium
tools/*.mp4
tools/*.mov
tools/*.avi

# Pliki robocze kompilacji rozszerzenia C++ (biblioteka gotowa leży w bin/)
native/build/
